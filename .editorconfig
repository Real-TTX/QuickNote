root = true
[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
[*.{yml,yaml,json,axaml,xml,csproj,props,svg}]
indent_size = 2
[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:suggestion
dotnet_sort_system_directives_first = true
